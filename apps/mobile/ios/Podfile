# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require 'fileutils'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# The engine pod compiles the FFmpeg backend only when VELMUX_FFMPEG_ROOT
# points at the packaged xcframework (see VelmuxEngine.podspec). The same
# variable decides whether the VelmuxEngineTests bundle may reference the
# real FFmpeg backend in C++ — the generated header below carries that
# decision to the test target at compile time.
velmux_ffmpeg_root = ENV['VELMUX_FFMPEG_ROOT']
velmux_ffmpeg_enabled = !velmux_ffmpeg_root.nil? && !velmux_ffmpeg_root.empty?

target 'Velmux' do
  config = use_native_modules!

  # The shared C++ engine (core + bridge facade + Apple backend), compiled
  # straight from the repository root — the same sources the Android app
  # builds through gradle/CMake. Single source of truth.
  pod 'VelmuxEngine', :path => '../../..'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # VelmuxEngineTests constructs the engine's real backends directly in
    # C++ (whole-pipeline and hybrid tests). Its FFmpeg-dependent code can
    # only compile — and link against the engine pod's objects — when this
    # install built the FFmpeg backend in, so the decision is mirrored into
    # a generated header the test target reads through the
    # $(PODS_ROOT)/VelmuxTestConfig header search path. Regenerated on
    # every `pod install`; lives in the generated Pods tree only.
    test_config_dir = File.join(__dir__, 'Pods', 'VelmuxTestConfig')
    FileUtils.mkdir_p(test_config_dir)
    File.write(
      File.join(test_config_dir, 'VelmuxEngineTestConfig.h'),
      "// GENERATED by apps/mobile/ios/Podfile — do not edit.\n" \
      "// 1 when the VelmuxEngine pod was built with the FFmpeg backend\n" \
      "// (VELMUX_FFMPEG_ROOT was set at `pod install`), 0 otherwise.\n" \
      "#define VELMUX_TEST_FFMPEG_BACKEND #{velmux_ffmpeg_enabled ? 1 : 0}\n"
    )
  end
end
